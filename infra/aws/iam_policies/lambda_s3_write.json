{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteIngestionOutputs",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": [
        "arn:aws:s3:::quantscope-data-dev-<unique-suffix>/raw/*",
        "arn:aws:s3:::quantscope-data-dev-<unique-suffix>/processed/*",
        "arn:aws:s3:::quantscope-data-dev-<unique-suffix>/factors/*"
      ]
    }
  ]
}