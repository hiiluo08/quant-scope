{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProducerSendToQueue",
      "Effect": "Allow",
      "Action": ["sqs:SendMessage"],
      "Resource": "arn:aws:sqs:*:*:quantscope-ingestion-queue"
    },
    {
      "Sid": "ProducerReadConfig",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::quantscope-data-*/config/*"
    }
  ]
}
